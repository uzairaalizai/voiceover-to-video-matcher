# OpenAI API Configuration
OPENAI_API_KEY=your_api_key_here

# Model Selection
MODEL=gpt-4-vision

# Matching Configuration
CONFIDENCE_THRESHOLD=0.7
MIN_MATCH_SCORE=0.5
MAX_MATCHES_PER_SEGMENT=3

# Processing Configuration
FRAME_SAMPLE_RATE=1  # Extract every nth frame
AUDIO_SEGMENT_MIN_LENGTH=2  # Minimum seconds per narration segment
VIDEO_CHUNK_DURATION=10  # Process video in 10-second chunks

# Output Configuration
DEBUG=false
VERBOSE=true
SAVE_INTERMEDIATE_RESULTS=true
